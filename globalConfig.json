{
  "pages": {
    "configuration": {
      "tabs": [
        {
          "name": "account",
          "table": {
            "actions": [
              "edit",
              "delete",
              "clone"
            ],
            "header": [
              {
                "label": "Name",
                "field": "name"
              },
              {
                "label": "Connection type",
                "field": "connection_type"
              },
              {
                "label": "Console URL",
                "field": "url"
              }
            ]
          },
          "entity": [
            {
              "type": "text",
              "label": "Name",
              "validators": [
                {
                  "type": "regex",
                  "errorMsg": "Account Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                  "pattern": "^[a-zA-Z]\\w*$"
                },
                {
                  "type": "string",
                  "errorMsg": "Length of input name should be between 1 and 100",
                  "minLength": 1,
                  "maxLength": 100
                }
              ],
              "field": "name",
              "help": "A unique name for the account.",
              "required": true
            },
            {
              "type": "singleSelect",
              "label": "Connection type",
              "field": "connection_type",
              "defaultValue": "cloud",
              "required": true,
              "options": {
                "disableSearch": true,
                "autoCompleteFields": [
                  {
                    "value": "cloud",
                    "label": "Cloud (api.ui.com, Site Manager API key)"
                  },
                  {
                    "value": "local",
                    "label": "Local console (UniFi Network API key)"
                  }
                ]
              },
              "help": "Cloud reaches every console on the account through api.ui.com. Local talks to one console directly."
            },
            {
              "type": "text",
              "label": "API key",
              "field": "api_key",
              "encrypted": true,
              "required": true,
              "help": "Cloud: a Site Manager API key from unifi.ui.com. Local: a key from UniFi Network, Settings, Control Plane, Integrations."
            },
            {
              "type": "text",
              "label": "Console URL",
              "field": "url",
              "required": false,
              "validators": [
                {
                  "type": "regex",
                  "pattern": "^(https://[^\\s]+)?$",
                  "errorMsg": "Enter an https:// URL, or leave empty for Cloud."
                }
              ],
              "help": "Local: the console address, for example https://192.168.1.1. Cloud: leave empty (https://api.ui.com)."
            },
            {
              "type": "checkbox",
              "label": "Verify TLS certificate",
              "field": "verify_ssl",
              "defaultValue": true,
              "help": "Untick only for a local console with a self-signed certificate."
            }
          ],
          "title": "Accounts"
        },
        {
          "type": "loggingTab"
        }
      ],
      "title": "Configuration",
      "description": "Set up your add-on"
    },
    "inputs": {
      "services": [
        {
          "name": "unifi_collect_hosts",
          "entity": [
            {
              "type": "text",
              "label": "Name",
              "validators": [
                {
                  "type": "regex",
                  "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                  "pattern": "^[a-zA-Z]\\w*$"
                },
                {
                  "type": "string",
                  "errorMsg": "Length of input name should be between 1 and 100",
                  "minLength": 1,
                  "maxLength": 100
                }
              ],
              "field": "name",
              "help": "A unique name for the data input.",
              "required": true
            },
            {
              "type": "interval",
              "label": "Interval",
              "defaultValue": "3600",
              "field": "interval",
              "options": {
                "range": [
                  300,
                  86400
                ]
              },
              "help": "Time interval of the data input, in seconds.",
              "required": true
            },
            {
              "type": "singleSelect",
              "label": "Account to use",
              "options": {
                "referenceName": "account"
              },
              "help": "Account to use for this input.",
              "field": "account",
              "required": true
            },
            {
              "type": "singleSelect",
              "label": "Index",
              "validators": [
                {
                  "type": "string",
                  "errorMsg": "Length of index name should be between 1 and 80.",
                  "minLength": 1,
                  "maxLength": 80
                }
              ],
              "defaultValue": "default",
              "options": {
                "endpointUrl": "data/indexes",
                "denyList": "^_.*$",
                "createSearchChoice": true
              },
              "field": "index",
              "required": true
            }
          ],
          "inputHelperModule": "unifi_collect_hosts_helper",
          "title": "UniFi Site Manager - Collect hosts"
        },
        {
          "name": "unifi_collect_sites",
          "entity": [
            {
